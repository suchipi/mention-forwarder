# Each platform switches on when its secret is present. Delete the blocks you don't want.

# --- GitHub ---------------------------------------------------------------
# Required. The secret you typed into the webhook settings.
GITHUB_WEBHOOK_SECRET=

# To let the bot add reactions and post replies, supply ONE of the following.
# A) GitHub App (works across every repo the app is installed on):
#GITHUB_APP_ID=
#GITHUB_PRIVATE_KEY_PATH=./github-app-private-key.pem
# The key can also be inlined; keep the quotes, they preserve the newlines.
#GITHUB_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----
#...
#-----END RSA PRIVATE KEY-----"
#
# B) Personal access token (simplest; needs write access to the repos you use):
#GITHUB_TOKEN=

# --- Slack ----------------------------------------------------------------
# Both required. Basic Information -> Signing Secret, and OAuth & Permissions -> Bot User OAuth Token.
# Bot scopes: app_mentions:read, plus reactions:write, chat:write (replies), im:history (DMs), users:read (names).
SLACK_SIGNING_SECRET=
SLACK_BOT_TOKEN=xoxb-

# --- Linear ---------------------------------------------------------------
# Required. Shown once when you create the webhook.
LINEAR_WEBHOOK_SECRET=
# Optional; needed for the acknowledgement reaction and for posting replies.
#LINEAR_API_KEY=
