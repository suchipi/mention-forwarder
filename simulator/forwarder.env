# Secrets shared by the forwarder and the simulator. They are fake on purpose: nothing
# outside this machine ever sees them, and both processes read this same file.
GITHUB_WEBHOOK_SECRET=simulator-github-secret
GITHUB_TOKEN=ghp_simulator_token
SLACK_SIGNING_SECRET=simulator-slack-secret
SLACK_BOT_TOKEN=xoxb-simulator-token
LINEAR_WEBHOOK_SECRET=simulator-linear-secret
LINEAR_API_KEY=lin_api_simulator
